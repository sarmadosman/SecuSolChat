# Copy to .env and fill in. Never commit .env.

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Where the security data lives ------------------------------------------
# USE_SQL is the top-level switch. When true, SQL_DSN decides which database and
# SECURITY_CLIENT is ignored.
USE_SQL=false

# Used when USE_SQL=true.
#   sqlite:///data/security.db
#   postgresql://chatbot_ro:password@host:5432/security
#   mysql://chatbot_ro:password@host:3306/security
# The account MUST be read-only. Application checks are the last line of
# defence, not the first:
#   CREATE ROLE chatbot_ro LOGIN PASSWORD '...';
#   GRANT SELECT ON alarms, events, logs, devices TO chatbot_ro;
SQL_DSN=sqlite:///data/security.db

# Used when USE_SQL=false: 'mock' (JSON fixtures) or 'api' (REST adapter).
SECURITY_CLIENT=mock

# --- Used when SECURITY_CLIENT=api ------------------------------------------
SECURITY_API_URL=
SECURITY_API_TOKEN=

# --- Testing without an API key ---------------------------------------------
# Swaps Claude for a scripted stand-in. Demonstrates the pipeline, not language
# understanding. Every reply is labelled.
OFFLINE_MODEL=false
